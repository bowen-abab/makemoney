# 从 Supabase 控制台 -> Connect 或 Settings -> API Keys 中获取
VITE_SUPABASE_URL=https://your-project.supabase.co
# 前端专用：新项目显示 Publishable key（sb_publishable_...）
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 老项目若只有 anon key，也可以填这里（二选一即可）
VITE_SUPABASE_ANON_KEY=

# 注意：secret key / service_role key 绝对不要放进前端或提交到 Git！
